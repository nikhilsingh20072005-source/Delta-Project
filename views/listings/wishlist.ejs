<% layout("/layouts/boilerplate") %>

<div class="container mt-4">

    <h2 class="mb-4">❤️ My Wishlist</h2>

    <% if (savedListings.length === 0) { %>

        <div class="text-center mt-5">
            <h4>Your wishlist is empty ❤️</h4>
            <p>Save your favourite listings and they will appear here.</p>

            <a href="/listings" class="btn btn-dark">
                Explore Listings
            </a>
        </div>

    <% } else { %>

        <div class="row">

            <% savedListings.forEach(listing => { %>

                <div class="col-md-4 mb-4">

                    <div class="card listing-card">

                        <a href="/listings/<%= listing._id %>">
                            <img
                                src="<%= listing.image.url %>"
                                class="card-img-top"
                                alt="listing image"
                            >
                        </a>

                        <div class="card-body">

                            <h5 class="card-title">
                                <%= listing.title %>
                            </h5>

                            <p class="card-text">
                                <%= listing.location %>, <%= listing.country %>
                            </p>

                            <p class="card-text">
                                <strong>
                                    ₹<%= listing.price != null
                                        ? listing.price.toLocaleString("en-IN")
                                        : "N/A" %>
                                </strong>
                                    / night
                            </p>

                            <a
                                href="/listings/<%= listing._id %>"
                                class="btn btn-outline-dark"
                            >
                                View Listing
                            </a>

                        </div>

                    </div>

                </div>

            <% }) %>

        </div>

    <% } %>

</div>